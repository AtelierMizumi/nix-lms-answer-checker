{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nix-helper-analytics",
    "main": "src/index.js",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat"],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "nix-helper-db",
            "database_id": "0289a97f-843e-4e8e-8c2d-9d1f00c69778"
        }
    ],
    "vars": {
        "SALT": "nix-helper-secure-telemetry-salt-2026"
    }
}
